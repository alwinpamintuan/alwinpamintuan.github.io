---
import { about, identity, professionalHub, projects, socialProfiles } from '../data/projects';
import { packBento } from '../data/bento';
import SiteFooter from '../components/SiteFooter.astro';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import sansRegular from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import '../styles/site-tokens.css';
import '../styles/global.css';
import '../styles/site-chrome.css';
import '../styles/site-transitions.css';

const desktopSpans = packBento(projects.length, false);
const wideSpans = packBento(projects.length, true);
const resumeIndex = projects.length + 1;
const cardSpan = (index: number) => ({
  '--span-desktop': desktopSpans[index],
  '--span-wide': wideSpans[index],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="preload" href={sansRegular} as="font" type="font/woff2" crossorigin="anonymous" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Personal projects, experiments, and things John Alwin Pamintuan makes outside of work." />
    <meta name="theme-color" content="#f3f2ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#20201e" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (() => {
        let preference;
        try {
          const saved = localStorage.getItem('personal-site:theme') ?? localStorage.getItem('project-index:theme');
          if (saved === 'light' || saved === 'dark') {
            preference = saved;
            localStorage.setItem('personal-site:theme', saved);
          }
        } catch { /* Storage restrictions do not prevent theme selection. */ }
        const theme = preference ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
        if (preference) document.documentElement.dataset.themePreference = preference;
        document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
          meta.setAttribute('content', theme === 'dark' ? '#20201e' : '#f3f2ec');
        });
      })();
    </script>
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{identity.name} · Projects</title>
  </head>
  <body>
    <a class="skip-link" href="#index">Skip to index</a>
    <div class="sheet">
      <header class="site-header">
        <a class="site-home" href="/">{identity.name}</a>
        <button class="theme-toggle" type="button" role="switch" aria-label="Dark mode" aria-checked="false" hidden>
          <span class="theme-track" aria-hidden="true"></span>
          <svg class="theme-icon theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5" />
          </svg>
          <svg class="theme-icon theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.5 14A9 9 0 0 1 10 3.5 9 9 0 1 0 20.5 14Z" />
          </svg>
        </button>
      </header>

      <main id="index" tabindex="-1" class="main">
        <section class="bento" aria-label="Projects and background">
          <ul class="bento-grid">
            <li class="bento-item bento-about" style={cardSpan(0)}>
              <div class="bento-card about-card">
                <h1 id="index-title">{about.heading.map((line) => <span>{line}{' '}</span>)}</h1>
                <p class="about-copy">{about.description}</p>
                <span class="about-location">{about.location}</span>
              </div>
            </li>
            {projects.map((project, index) => (
              <li class:list={['bento-item', { 'bento-lead': index === 0 }]} style={cardSpan(index + 1)}>
                <a class="bento-card bento-link project-card" id={project.id} href={project.url} aria-label={'Open ' + project.label}>
                  <div class="project-caption">
                    <div><h2>{project.label}</h2><p>{project.description}</p></div>
                    <span class="card-action">Open app <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg></span>
                  </div>
                  <div class="project-image-well">
                    <img class="project-screenshot" style={{ objectPosition: 'position' in project.preview.screenshot ? project.preview.screenshot.position : '50% 50%' }} src={project.preview.screenshot.src} alt={project.preview.screenshot.alt}
                      width={project.preview.screenshot.width} height={project.preview.screenshot.height}
                      loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
                  </div>
                </a>
              </li>
            ))}
            <li class="bento-item" style={cardSpan(resumeIndex)}
              data-full-desktop={desktopSpans[resumeIndex] === 12 || undefined}
              data-full-wide={wideSpans[resumeIndex] === 12 || undefined}
              data-full-tablet={resumeIndex % 2 === 0 || undefined}>
              <a class="bento-card bento-link resume-card" href={new URL(professionalHub.url).pathname} aria-label="View résumé">
                <div><h2>The résumé.</h2><p>What I do, where I’ve been, and what I’ve learned.</p></div>
                <span class="card-action">View résumé <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg></span>
              </a>
            </li>
          </ul>
        </section>
      </main>

      <SiteFooter profiles={socialProfiles} email={identity.email} topHref="#index" />
    </div>
    <script src="../scripts/index.ts"></script>
  </body>
</html>
